\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vectra-accessibility}[2026/06/30 v0.2.0 VECTRA accessibility settings]

\RequirePackage{iftex}

\ifPDFTeX
    \input{glyphtounicode}
    \pdfgentounicode=1
\fi

\newcommand{\Vectra@pdftitle}{Curriculum Vitae}
\newcommand{\Vectra@pdfauthor}{}
\newcommand{\Vectra@pdfsubject}{Curriculum Vitae}
\newcommand{\Vectra@pdfkeywords}{CV, resume, academic CV}

\newcommand{\VectraSetPDFTitle}[1]{\renewcommand{\Vectra@pdftitle}{#1}}
\newcommand{\VectraSetPDFAuthor}[1]{\renewcommand{\Vectra@pdfauthor}{#1}}
\newcommand{\VectraSetPDFSubject}[1]{\renewcommand{\Vectra@pdfsubject}{#1}}
\newcommand{\VectraSetPDFKeywords}[1]{\renewcommand{\Vectra@pdfkeywords}{#1}}

\RequirePackage[
    colorlinks=true,
    urlcolor=VectraLinkColor,
    linkcolor=VectraLinkColor,
    citecolor=VectraLinkColor
]{hyperref}

\RequirePackage{bookmark}

\AtBeginDocument{%
    \hypersetup{
        pdftitle={\Vectra@pdftitle},
        pdfauthor={\Vectra@pdfauthor},
        pdfsubject={\Vectra@pdfsubject},
        pdfkeywords={\Vectra@pdfkeywords},
        pdfcreator={VECTRA}
    }%
}

\endinput
