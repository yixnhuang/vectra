\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vectra-sections}[2026/06/29 v0.1.0 VECTRA section commands]

\RequirePackage{titlesec}

% ---------------------------------------------------------------------------
% Section formatting
% ---------------------------------------------------------------------------

\titleformat{\section}
    {\needspace{4\baselineskip}\VectraSectionFont}
    {}
    {0pt}
    {}
    [\vspace{\VectraSectionRuleSpace}{\color{VectraRuleColor}\titlerule[\VectraSectionRuleThickness]}]

\titlespacing{\section}
    {0pt}
    {\VectraSectionTopSpace}
    {\VectraSectionBottomSpace}

% ---------------------------------------------------------------------------
% Internal line-building helpers
% ---------------------------------------------------------------------------
%
% These helpers make optional fields safe.
%
% A field is printed only if its raw value is non-empty. If a field is empty,
% it does not create a blank line, a label, or an extra line break.
%
% This is important for entries where fields such as advisor, topics,
% technologies, date, location, issuer, or notes may be intentionally omitted.

\newif\ifVectra@entrylineprinted

\NewDocumentCommand{\Vectra@BeginEntryLines}{}{%
    \Vectra@entrylineprintedfalse
}

\NewDocumentCommand{\Vectra@EntryLine}{m m}{%
    \ifblank{#1}{}{%
        \ifVectra@entrylineprinted
            \VectraEntryBreak
        \fi
        #2%
        \Vectra@entrylineprintedtrue
    }%
}

\NewDocumentCommand{\Vectra@MetaBlock}{m m}{%
    \Vectra@BeginEntryLines
    \Vectra@EntryLine{#1}{\textit{#1}}%
    \Vectra@EntryLine{#2}{\textit{#2}}%
}

% ---------------------------------------------------------------------------
% Section command
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraSection}{m}{%
    \par
    \Vectra@CancelLastEntryGap
    \section{#1}%
}

% ---------------------------------------------------------------------------
% Research interests
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraResearchInterests}{+m}{%
    \Vectra@OneColumnBlock{#1}%
    \Vectra@NormalGap
}

% ---------------------------------------------------------------------------
% Education
%
% Arguments:
%   1 Institution
%   2 Degree or program
%   3 Location
%   4 Date
%
% Location and date may be left empty.
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraEducationEntry}{mmmm}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{#4}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
        \Vectra@EntryLine{#2}{#2}%
    }%
    \Vectra@EducationGap
}

% ---------------------------------------------------------------------------
% Research experience
%
% Arguments:
%   1 Institution
%   2 Role
%   3 Location
%   4 Date
%   5 Advisor
%   6 Topics
%   7 Bullet items
%
% Advisor, topics, location, date, and bullets may be left empty.
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraResearchExperienceEntry}{mmmmmm +m}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{#4}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
        \Vectra@EntryLine{#2}{#2}%
        \Vectra@EntryLine{#6}{\textit{Topics: #6}}%
        \Vectra@EntryLine{#5}{Advisor: #5}%
    }%
    \IfBlankTF{#7}{%
        \Vectra@NormalGap
    }{%
        \Vectra@BeforeBullets
        \begin{VectraBullets}
            #7%
        \end{VectraBullets}
        \Vectra@NormalGap
    }%
}

% ---------------------------------------------------------------------------
